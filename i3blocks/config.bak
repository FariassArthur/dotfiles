[global]
markup=pango
separator=true
separator_block_width=15
background=#2e3440
color=#d8dee9

[interface]
label=🌐
command=IF=$(ip route 2>/dev/null | awk '/default/ {print $5; exit}'); [ -z "$IF" ] && IF=$(ls /sys/class/net 2>/dev/null | grep -v '^lo$' | head -n1); [ -z "$IF" ] && { echo "N/A"; exit 0; }; IP=$(ip -4 addr show "$IF" 2>/dev/null | awk '/inet / {print $2; exit}' | cut -d/ -f1); [ -z "$IP" ] && IP="N/A"; echo "$IF: $IP"; exit 0
interval=5
background=#2e3440
color=#8fbcbb

[bandwidth]
label=📊
command=IF=$(ip route 2>/dev/null | awk '/default/ {print $5; exit}'); [ -z "$IF" ] && IF=$(ls /sys/class/net 2>/dev/null | grep -v '^lo$' | head -n1); [ -z "$IF" ] && { echo "N/A"; exit 0; }; set -- $(awk -v iface="$IF" '$1 ~ iface":" {print $2, $10}' /proc/net/dev 2>/dev/null); [ -z "$1" ] && { echo "N/A"; exit 0; }; RX=$1; TX=$2; F=/tmp/i3blocks_bw_${IF}; C=$(date +%s); if [ -f "$F" ]; then read P PRX PTX PT <"$F" 2>/dev/null; if [ -n "$PRX" ] && [ "$C" -gt "$PT" ] 2>/dev/null; then DIFF=$((C-PT)); RXK=$(( (RX-PRX) / DIFF / 1024 )); TXK=$(( (TX-PTX) / DIFF / 1024 )); echo "↓${RXK}KB/s ↑${TXK}KB/s"; else echo "↓0KB/s ↑0KB/s"; fi; else echo "↓0KB/s ↑0KB/s"; fi; echo "$IF $RX $TX $C" > "$F"; exit 0
interval=1
background=#2e3440
color=#a3be8c

[ping]
label=📡
command=LAT=$(ping -c 1 -W 2 1.1.1.1 2>/dev/null | grep -o 'time=[0-9.]*' | head -n1 | cut -d= -f2); [ -z "$LAT" ] && LAT="N/A"; echo "${LAT}ms"; exit 0
interval=10
background=#2e3440
color=#ebcb8b

[connections]
label=🔌
command=if command -v ss >/dev/null 2>&1; then N=$(ss -tuna 2>/dev/null | grep -c 'ESTAB'); else N=$(awk 'NR>1 && $4=="01" {c++} END {print c+0}' /proc/net/tcp /proc/net/tcp6 2>/dev/null); fi; echo "${N:-0}"; exit 0
interval=5
background=#2e3440
color=#81a1c1

[listening]
label=🚪
command=if command -v ss >/dev/null 2>&1; then N=$(ss -tuna 2>/dev/null | grep -cE 'LISTEN|UNCONN'); else N=$(awk 'NR>1 && $4=="0A" {c++} END {print c+0}' /proc/net/tcp /proc/net/tcp6 2>/dev/null); fi; echo "${N:-0}"; exit 0
interval=5
background=#2e3440
color=#b48ead

[cpu]
label=🖥
command=F=/tmp/i3blocks_cpu; C=$(date +%s); set -- $(awk '/^cpu / {t=0; for(i=2;i<=8;i++) t+=$i; print t, $5}' /proc/stat 2>/dev/null); [ -z "$1" ] && { echo "N/A"; exit 0; }; T=$1; I=$2; if [ -f "$F" ]; then read PT PI PT2 <"$F" 2>/dev/null; if [ -n "$PT" ] && [ "$C" -gt "$PT2" ] 2>/dev/null; then DIFF=$((T-PT)); IDLED=$((I-PI)); [ "$DIFF" -gt 0 ] && U=$((100*(DIFF-IDLED)/DIFF)) || U=0; echo "${U}%"; else echo "0%"; fi; else echo "0%"; fi; echo "$T $I $C" > "$F"; exit 0
interval=2
background=#2e3440
color=#d08770

[memory]
label=🧠
command=M=$(free -m 2>/dev/null | awk 'NR==2 {if($2>0) printf "%.1f%%", $3*100/$2; else print "N/A"; exit}'); [ -z "$M" ] && M="N/A"; echo "$M"; exit 0
interval=5
background=#2e3440
color=#bf616a

[disk]
label=💾
command=D=$(df -h / 2>/dev/null | awk 'NR==2 {print $5}'); [ -z "$D" ] && D="N/A"; echo "$D"; exit 0
interval=30
background=#2e3440
color=#81a1c1

[volume]
label=🔊
command=if command -v pactl >/dev/null 2>&1; then if pactl get-sink-mute @DEFAULT_SINK@ 2>/dev/null | grep -q 'Mute: yes'; then echo "mute"; else V=$(pactl get-sink-volume @DEFAULT_SINK@ 2>/dev/null | awk -F'/' '/Volume/ {print $2; exit}' | tr -d ' '); echo "${V:-0}"; fi; else echo "N/A"; fi; exit 0
interval=1
background=#2e3440
color=#a3be8c

[weather]
label=🌦
command=W=$(curl -fsS --max-time 5 'wttr.in/?format=1' 2>/dev/null); [ -z "$W" ] && W="N/A"; echo "$W"; exit 0
interval=600
background=#2e3440
color=#8fbcbb

[datetime]
label=📅
command=date '+%a %d/%m %H:%M'
interval=5
background=#2e3440
color=#d8dee9
