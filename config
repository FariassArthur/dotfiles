{
    "layer": "top",
    "position": "top",
    "height": 32,
    "spacing": 4,
    "modules-left": ["sway/workspaces", "sway/mode"],
    "modules-center": ["clock"],
    "modules-right": ["network#speed", "network#status", "cpu", "memory", "pulseaudio"],
    
"sway/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "format": "{name}"
    },

    "clock": {
        "format": "󰃭 {:%d/%m/%Y   %H:%M}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },

    "network#speed": {
        "format-ethernet": " {bandidtw}  {banduwt}", // Mostra a taxa de download/upload atual
        "format-wifi": " {bandidtw}  {banduwt}",
        "interval": 2
    },

    "network#status": {
        "interface": "enp*", // Ajuste se sua interface rede cabeada tiver outro padrão (ex: eth0)
        "format-ethernet": "󰈀 {ipaddr}/{cidr}", // Mostra IP e Máscara em formato CIDR (essencial para redes)
        "format-wifi": " {essid} ({ipaddr})",
        "format-disconnected": "󰈂 Desconectado",
        "tooltip-format": "Placa: {ifname}\nGateway: {gwaddr}"
    },

    "cpu": {
        "format": " {usage}%",
        "tooltip": true,
        "interval": 2
    },

    "memory": {
        "format": " {percentage}%",
        "tooltip-format": "Usado: {used}GiB / Total: {total}GiB",
        "interval": 2
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟 Muted",
        "format-icons": {
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle"
    },

    "tray": {
        "icon-size": 16,
        "spacing": 10
    }
}
